{
  "name": "nexa",
  "private": true,
  "description": "NEXA Workplace - internal social + communication platform",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nexa/api dev",
    "dev:web": "pnpm --filter @nexa/web dev",
    "api-client:generate": "pnpm --filter @nexa/api-client generate",
    "build": "pnpm -r build",
    "start": "pnpm --filter @nexa/api start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}

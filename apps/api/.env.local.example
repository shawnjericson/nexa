# Settings for running NEXA on your own machine against `docker compose up` (see the README).
# Copy to .env. Nothing in here is a secret: never use these values on a server.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

DATABASE_URL=postgresql://nexa:nexa@localhost:5432/nexa
SHADOW_DATABASE_URL=postgresql://nexa:nexa@localhost:5432/nexa_shadow
TEST_DATABASE_URL=postgresql://nexa:nexa@localhost:5432/nexa_test
DATABASE_SSL=false

# Optional. With `docker compose --profile redis up -d`: REDIS_URL=redis://localhost:6379
# Without Redis the API runs as a single instance with presence kept in memory.
REDIS_URL=
# Optional: the audit log (MongoDB) and file uploads (any S3-compatible bucket) stay off.
MONGODB_URI=
S3_BUCKET=

JWT_ACCESS_SECRET=local-development-only-not-a-secret-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

# Anyone who registers joins this organization, and "Try the demo" on the front page drops a
# visitor into it. Fill it with sample people, posts and chats using scripts/seed-demo.ts.
DEFAULT_ORG_SLUG=nexa
DEFAULT_ORG_NAME=NEXA
SIGNUP_MODE=open
DEMO_ORG_SLUG=nexa

// NEXA v1 database schema (PostgreSQL 18). Connection settings live in prisma.config.ts.
//
// Conventions:
// - UUIDv7 primary keys generated by PostgreSQL (time-ordered, non-guessable)
// - snake_case tables and columns, timestamptz(3) timestamps
// - Tenant-owned tables carry organization_id; composite foreign keys keep related rows in the
//   same organization
// - Extensions and reference data (permissions) are created in migration SQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ──────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

/// A person's identity. Company membership is modeled separately (spec: Identity != Organization).
/// Users are deactivated, never hard-deleted, so historical content keeps its author.
model User {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String     @unique @db.Citext
  username     String     @unique @db.Citext
  displayName  String     @map("display_name") @db.VarChar(100)
  passwordHash String     @map("password_hash") @db.VarChar(100)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(2048)
  bio          String?    @db.VarChar(500)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens        RefreshToken[]
  memberships          OrganizationMember[]
  posts                Post[]
  comments             Comment[]
  reactions            Reaction[]
  invitationsSent      Invitation[]         @relation("InvitationsSent")
  invitationsAccepted  Invitation[]         @relation("InvitationsAccepted")
  conversationsCreated Conversation[]       @relation("ConversationsCreated")
  messages             Message[]
  notifications        Notification[]       @relation("NotificationsReceived")
  notificationsCaused  Notification[]       @relation("NotificationsCaused")
  filesUploaded        File[]

  @@map("users")
}

/// One row per issued refresh token; only the SHA-256 hash is stored.
/// All tokens of one login session share a family_id. Presenting an already-rotated token
/// revokes the whole family (risk register 4.5).
model RefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── Organization ──────────────────────────────────────────────────────────

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.Citext
  logoUrl   String?  @map("logo_url") @db.VarChar(2048)
  timezone  String   @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         Role[]
  members       OrganizationMember[]
  invitations   Invitation[]
  departments   Department[]
  posts         Post[]
  conversations Conversation[]
  notifications Notification[]
  files         File[]

  @@map("organizations")
}

/// Roles belong to one organization. Every organization gets the system roles
/// OWNER, ADMIN, MANAGER and MEMBER when it is created; custom roles can come later.
model Role {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(50)
  name           String   @db.VarChar(100)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  // Target of the composite FKs that keep a member's / invitation's role inside its organization.
  @@unique([id, organizationId])
  @@map("roles")
}

/// Reference data seeded by migrations, e.g. "post.moderate", "member.invite".
model Permission {
  key         String @id @db.VarChar(100)
  description String @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(100)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model OrganizationMember {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id])
  // Composite FK: the database itself rejects a role from another organization. NO ACTION (checked
  // at the end of the statement) lets an organization delete cascade through roles and members.
  role          Role                 @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: NoAction)
  departments   DepartmentMember[]
  conversations ConversationMember[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Invitation to join an organization. The token is stored only as a SHA-256 hash and works once,
/// for the invited email address, until it expires.
model Invitation {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.Citext
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedById   String?   @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: NoAction)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InvitationsAccepted", fields: [acceptedById], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
}

model Department {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  slug           String   @db.Citext
  description    String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      DepartmentMember[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@map("departments")
}

/// A member's place in a department. Both composite foreign keys keep the row inside one
/// organization, and leaving the organization removes it automatically.
model DepartmentMember {
  departmentId   String   @map("department_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  department Department         @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  member     OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@id([departmentId, userId])
  @@index([organizationId, userId])
  @@map("department_members")
}

// ─── Social ────────────────────────────────────────────────────────────────

enum PostType {
  GENERAL
  ANNOUNCEMENT
  EVENT
  POLL
}

enum PostVisibility {
  ORGANIZATION
  DEPARTMENT
  CHANNEL
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  CELEBRATE
  SAD
}

/// Tenant-owned: every query is scoped by organization_id. Deleting is a soft delete
/// (deleted_at) so comments and audit history keep their integrity (risk register 7.3).
model Post {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  authorId       String         @map("author_id") @db.Uuid
  content        String
  imageUrl       String?        @map("image_url") @db.VarChar(2048)
  type           PostType       @default(GENERAL)
  visibility     PostVisibility @default(ORGANIZATION)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
  comments     Comment[]
  reactions    Reaction[]
  attachments  PostAttachment[]

  // Target of the composite FKs that keep comments/reactions inside the post's organization.
  @@unique([id, organizationId])
  // Feed: newest first within an organization, keyset-paginated on (created_at, id).
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
  @@map("posts")
}

/// Replies are one level deep: parent_id always points at a top-level comment.
model Comment {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  content        String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  // Composite FK: a comment always lives in the same organization as its post.
  post    Post      @relation(fields: [postId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, createdAt, id])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

/// One reaction per person and post (risk register 7.2); reacting again replaces the type.
model Reaction {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  postId         String       @map("post_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  type           ReactionType
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId, type])
  @@index([userId])
  @@map("reactions")
}

// ─── Communication ─────────────────────────────────────────────────────────

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

enum ConversationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

/// DIRECT, GROUP or CHANNEL - a channel is a conversation (spec 9.4). Messages are ordered by a
/// per-conversation sequence assigned under a lock on this row (ADR-015).
model Conversation {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  type           ConversationType
  name           String?          @db.VarChar(100)
  description    String?          @db.VarChar(500)
  avatarUrl      String?          @map("avatar_url") @db.VarChar(2048)
  /// Channels only, unique per organization.
  slug           String?          @db.Citext
  /// DIRECT only: both user ids sorted, so a pair of people has at most one conversation.
  directKey      String?          @map("direct_key") @db.VarChar(80)
  createdById    String           @map("created_by_id") @db.Uuid
  lastMessageSeq Int              @default(0) @map("last_message_seq")
  lastMessageAt  DateTime?        @map("last_message_at") @db.Timestamptz(3)
  /// Orders conversation lists: creation time until the first message, then the last message.
  lastActivityAt DateTime         @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("ConversationsCreated", fields: [createdById], references: [id])
  members      ConversationMember[]
  messages     Message[]

  @@unique([organizationId, slug])
  @@unique([organizationId, directKey])
  @@unique([id, organizationId])
  @@index([organizationId, type])
  @@map("conversations")
}

/// Membership is anchored in the organization: leaving the organization removes the person from
/// every conversation (risk register 10), while their messages stay in the history.
model ConversationMember {
  conversationId String           @map("conversation_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           ConversationRole @default(MEMBER)
  /// Only ever moves forward (risk register 9.6).
  lastReadSeq    Int              @default(0) @map("last_read_seq")
  mutedUntil     DateTime?        @map("muted_until") @db.Timestamptz(3)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)

  conversation Conversation       @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  member       OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([organizationId, userId])
  @@map("conversation_members")
}

/// seq is gap-free and server-assigned (risk register 9.2); client_message_id makes retries
/// idempotent (9.1). Deleted messages stay as tombstones (9.7).
model Message {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  senderId        String      @map("sender_id") @db.Uuid
  seq             Int
  clientMessageId String?     @map("client_message_id") @db.VarChar(64)
  type            MessageType @default(TEXT)
  content         String
  replyToId       String?     @map("reply_to_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt        DateTime?   @map("edited_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  replyTo      Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReplies")
  attachments  MessageAttachment[]

  @@unique([conversationId, seq])
  @@unique([conversationId, senderId, clientMessageId])
  // Target of the composite FK that keeps attachments inside the message's organization.
  @@unique([id, organizationId])
  @@map("messages")
}

// ─── Files ─────────────────────────────────────────────────────────────────

enum FileStatus {
  PENDING
  READY
  FAILED
}

/// Metadata of an object in object storage (spec 12); the bytes never touch PostgreSQL.
/// PENDING until the uploaded object has been verified; FAILED when it was rejected or abandoned.
model File {
  id             String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  uploadedById   String     @map("uploaded_by_id") @db.Uuid
  /// Random, never derived from the filename (ADR-017).
  storageKey     String     @unique @map("storage_key") @db.VarChar(300)
  filename       String     @db.VarChar(255)
  mimeType       String     @map("mime_type") @db.VarChar(127)
  size           Int
  status         FileStatus @default(PENDING)
  failureReason  String?    @map("failure_reason") @db.VarChar(200)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt     DateTime?  @map("uploaded_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy         User                @relation(fields: [uploadedById], references: [id])
  postAttachments    PostAttachment[]
  messageAttachments MessageAttachment[]

  // Target of the composite FKs that keep attachments inside the file's organization.
  @@unique([id, organizationId])
  @@index([uploadedById, status, createdAt])
  @@index([status, createdAt])
  @@map("files")
}

/// A file shown in a post. The file side is NO ACTION: a referenced file can't be deleted (risk
/// register 13), while deleting the post or the organization removes the reference with it.
model PostAttachment {
  postId         String @map("post_id") @db.Uuid
  fileId         String @map("file_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  position       Int

  post Post @relation(fields: [postId, organizationId], references: [id, organizationId], onDelete: Cascade)
  file File @relation(fields: [fileId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@id([postId, fileId])
  @@index([fileId])
  @@map("post_attachments")
}

/// A file sent in a message; removed when the message is deleted (ADR-017).
model MessageAttachment {
  messageId      String @map("message_id") @db.Uuid
  fileId         String @map("file_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  position       Int

  message Message @relation(fields: [messageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  file    File    @relation(fields: [fileId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@id([messageId, fileId])
  @@index([fileId])
  @@map("message_attachments")
}

// ─── Notification & platform ───────────────────────────────────────────────

/// In-app notification (spec 11). While unread, notifications with the same group_key are
/// coalesced into one with a count, so 1,000 likes stay one notification (risk register 12.3).
model Notification {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  recipientId    String    @map("recipient_id") @db.Uuid
  actorId        String?   @map("actor_id") @db.Uuid
  type           String    @db.VarChar(64)
  entityType     String    @map("entity_type") @db.VarChar(32)
  entityId       String    @map("entity_id") @db.Uuid
  groupKey       String?   @map("group_key") @db.VarChar(200)
  count          Int       @default(1)
  metadata       Json      @default("{}")
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Last activity (creation or a coalesced event). Deliberately not bumped by reading.
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    User         @relation("NotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        User?        @relation("NotificationsCaused", fields: [actorId], references: [id], onDelete: SetNull)

  // Most recently active first, per recipient and organization.
  @@index([recipientId, organizationId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, organizationId, groupKey])
  @@map("notifications")
}

/// Idempotency for event consumers: each event is applied once per consumer (risk register 12.2).
model ProcessedEvent {
  consumer    String   @db.VarChar(64)
  eventId     String   @map("event_id") @db.VarChar(64)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
}

/// Audit entries MongoDB could not take yet; a background job retries them (ADR-016).
model PendingAuditEvent {
  eventId   String   @id @map("event_id") @db.VarChar(64)
  entry     Json
  attempts  Int      @default(0)
  lastError String?  @map("last_error") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("pending_audit_events")
}

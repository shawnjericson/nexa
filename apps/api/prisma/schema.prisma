// NEXA v1 database schema (PostgreSQL 18). Connection settings live in prisma.config.ts.
//
// Conventions:
// - UUIDv7 primary keys generated by PostgreSQL (time-ordered, non-guessable)
// - snake_case tables and columns, timestamptz(3) timestamps
// - Tenant-owned tables carry organization_id; composite foreign keys keep related rows in the
//   same organization
// - Extensions and reference data (permissions) are created in migration SQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ──────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

/// A person's identity. Company membership is modeled separately (spec: Identity != Organization).
/// Users are deactivated, never hard-deleted, so historical content keeps its author.
model User {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String     @unique @db.Citext
  username     String     @unique @db.Citext
  displayName  String     @map("display_name") @db.VarChar(100)
  passwordHash String     @map("password_hash") @db.VarChar(100)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(2048)
  bio          String?    @db.VarChar(500)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  memberships         OrganizationMember[]
  posts               Post[]
  comments            Comment[]
  reactions           Reaction[]
  invitationsSent     Invitation[]         @relation("InvitationsSent")
  invitationsAccepted Invitation[]         @relation("InvitationsAccepted")

  @@map("users")
}

/// One row per issued refresh token; only the SHA-256 hash is stored.
/// All tokens of one login session share a family_id. Presenting an already-rotated token
/// revokes the whole family (risk register 4.5).
model RefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── Organization ──────────────────────────────────────────────────────────

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.Citext
  logoUrl   String?  @map("logo_url") @db.VarChar(2048)
  timezone  String   @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles       Role[]
  members     OrganizationMember[]
  invitations Invitation[]
  departments Department[]
  posts       Post[]

  @@map("organizations")
}

/// Roles belong to one organization. Every organization gets the system roles
/// OWNER, ADMIN, MANAGER and MEMBER when it is created; custom roles can come later.
model Role {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(50)
  name           String   @db.VarChar(100)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  // Target of the composite FKs that keep a member's / invitation's role inside its organization.
  @@unique([id, organizationId])
  @@map("roles")
}

/// Reference data seeded by migrations, e.g. "post.moderate", "member.invite".
model Permission {
  key         String @id @db.VarChar(100)
  description String @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(100)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model OrganizationMember {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id])
  // Composite FK: the database itself rejects a role from another organization. NO ACTION (checked
  // at the end of the statement) lets an organization delete cascade through roles and members.
  role         Role               @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: NoAction)
  departments  DepartmentMember[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Invitation to join an organization. The token is stored only as a SHA-256 hash and works once,
/// for the invited email address, until it expires.
model Invitation {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.Citext
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedById   String?   @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: NoAction)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InvitationsAccepted", fields: [acceptedById], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
}

model Department {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  slug           String   @db.Citext
  description    String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      DepartmentMember[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@map("departments")
}

/// A member's place in a department. Both composite foreign keys keep the row inside one
/// organization, and leaving the organization removes it automatically.
model DepartmentMember {
  departmentId   String   @map("department_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  department Department         @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  member     OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@id([departmentId, userId])
  @@index([organizationId, userId])
  @@map("department_members")
}

// ─── Social ────────────────────────────────────────────────────────────────

enum PostType {
  GENERAL
  ANNOUNCEMENT
  EVENT
  POLL
}

enum PostVisibility {
  ORGANIZATION
  DEPARTMENT
  CHANNEL
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  CELEBRATE
  SAD
}

/// Tenant-owned: every query is scoped by organization_id. Deleting is a soft delete
/// (deleted_at) so comments and audit history keep their integrity (risk register 7.3).
model Post {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  authorId       String         @map("author_id") @db.Uuid
  content        String
  imageUrl       String?        @map("image_url") @db.VarChar(2048)
  type           PostType       @default(GENERAL)
  visibility     PostVisibility @default(ORGANIZATION)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
  comments     Comment[]
  reactions    Reaction[]

  // Target of the composite FKs that keep comments/reactions inside the post's organization.
  @@unique([id, organizationId])
  // Feed: newest first within an organization, keyset-paginated on (created_at, id).
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
  @@map("posts")
}

/// Replies are one level deep: parent_id always points at a top-level comment.
model Comment {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  content        String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  // Composite FK: a comment always lives in the same organization as its post.
  post    Post      @relation(fields: [postId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, createdAt, id])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

/// One reaction per person and post (risk register 7.2); reacting again replaces the type.
model Reaction {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  postId         String       @map("post_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  type           ReactionType
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId, type])
  @@index([userId])
  @@map("reactions")
}

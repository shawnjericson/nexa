# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Number of reverse-proxy hops in front of the API (0 locally, 1 behind nginx)
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

# PostgreSQL on the VPS - role "nexa" is only reachable from whitelisted IPs (ADR-011)
DATABASE_URL=postgresql://nexa:CHANGE_ME@139.180.139.17:5432/nexa
SHADOW_DATABASE_URL=postgresql://nexa:CHANGE_ME@139.180.139.17:5432/nexa_shadow
# Integration tests truncate tables - must point to a *_test database
TEST_DATABASE_URL=postgresql://nexa:CHANGE_ME@139.180.139.17:5432/nexa_test
# Encrypt the connection; pin the server certificate with DATABASE_SSL_CA_FILE (see README)
DATABASE_SSL=true
DATABASE_SSL_CA_FILE=certs/postgres-server.pem

# MongoDB (audit/event log). FlashPanel creates users in the admin DB.
MONGODB_URI=mongodb://NEXA:CHANGE_ME@139.180.139.17:27017/NEXA?authSource=admin

# Auth - generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
BCRYPT_ROUNDS=12

# Organization every self-registered user joins (ADR-010)
DEFAULT_ORG_SLUG=nexa
DEFAULT_ORG_NAME=NEXA

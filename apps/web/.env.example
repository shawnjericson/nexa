# Where the browser reaches the NEXA API (REST and Socket.IO). The API must list this app's
# origin in CORS_ORIGINS. Baked into the build: rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the Next.js server reaches the API for the session routes (defaults to the value above).
# On the server, point it straight at the API process, e.g. http://127.0.0.1:4100.
API_URL=http://localhost:4000

# Only needed when the reverse proxy doesn't pass the public host to Next.js: the origins allowed
# to use the sign-in routes, comma-separated, e.g. https://nexa.example.com
APP_ORIGINS=

# Sign in with Google (ADR-020). Create an OAuth client in the Google Cloud console and register
# <PUBLIC_APP_URL>/api/session/oauth/google/callback as an authorized redirect URI. The API needs
# the same client id in its own GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The address people use, when the reverse proxy passes neither host nor protocol. It must match
# the redirect URI registered with Google, e.g. https://nexa.example.com
PUBLIC_APP_URL=

# The public repository, shown as "View the source" on the landing page. Leave empty to hide it,
# so a private repository never becomes a dead link.
REPO_URL=

# Where the browser reaches the NEXA API (REST and Socket.IO). The API must list this app's
# origin in CORS_ORIGINS. Baked into the build: rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the Next.js server reaches the API for the session routes (defaults to the value above).
# On the server, point it straight at the API process, e.g. http://127.0.0.1:4100.
API_URL=http://localhost:4000

# Only needed when the reverse proxy doesn't pass the public host to Next.js: the origins allowed
# to use the sign-in routes, comma-separated, e.g. https://nexa.example.com
APP_ORIGINS=
